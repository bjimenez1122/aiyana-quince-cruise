---
export interface Props {
  label?: string
  targetDate: string
}
const { label, targetDate } = Astro.props
---

<div class="flex flex-col items-center gap-4 text-current">
  <h2 class="text-6xl font-bold">{label}</h2>
</div>
<div class="countdown">
  <div class="time-section" id="seconds">
    <div class="time-group">
      <div class="time-segment">
        <div class="segment-display">
          <div class="segment-display__top">2</div>
          <div class="segment-display__bottom">2</div>
          <div class="segment-overlay">
            <div class="segment-overlay__top">2</div>
            <div class="segment-overlay__bottom">2</div>
          </div>
        </div>
      </div>
      <div class="time-segment">
        <div class="segment-display">
          <div class="segment-display__top">2</div>
          <div class="segment-display__bottom">2</div>
          <div class="segment-overlay">
            <div class="segment-overlay__top">2</div>
            <div class="segment-overlay__bottom">2</div>
          </div>
        </div>
      </div>
    </div>
    <p>Seconds</p>
  </div>
</div>

<style lang="scss">
  // * {
  //   box-sizing: border-box;
  // }

  // body {
  //   padding-top: 100px;
  // }

  .countdown {
    display: flex;
    gap: 30px;
  }

  .time-section {
    text-align: center;
    font-size: 30px;
  }

  .time-group {
    display: flex;
    gap: 10px;
  }

  .time-segment {
    display: block;
    font-size: 100px;
    // font-weight: 900;
  }
</style>