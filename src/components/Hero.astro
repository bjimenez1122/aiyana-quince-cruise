---
---

<section class="hero" id="hero">
  <div class="hero-bg">
    <div class="hero-overlay"></div>
    <img
      src="/disneyfantasycastaway.avif"
      alt="Disney Fantasy cruise ship"
      class="hero-img"
    />
  </div>

  <div class="hero-content">
    <div class="hero-text">
      <h1 class="hero-headline">
        Aiyana's<br />
        <em>Quinceañera at Sea</em>
      </h1>
      <p class="hero-body">
        Once upon a voyage… join us on the Disney Fantasy for 5 enchanted nights through the Bahamas as we celebrate Aiyana's quinceañera.
      </p>
      <div class="hero-cta">
        <a href="#booking" class="btn-primary">View Booking Details</a>
        <a href="#itinerary" class="btn-ghost">See the Itinerary</a>
      </div>
    </div>

    <div class="hero-card-wrap">
      <div class="hero-ship-card">
        <img
          src="/captain-minnie.jpg"
          alt="Captain Minnie welcoming guests aboard"
          class="hero-ship-img"
        />
      </div>
      <div class="hero-detail-badge glass-panel">
        <span class="badge-ship">Disney Fantasy</span>
        <span class="badge-sparkle">✦</span>
        <span class="badge-dates">Aug 28 – Sep 2, 2026</span>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .hero {
    position: relative;
    min-height: 90vh;
    display: flex;
    align-items: center;
    padding: 5rem 2rem 4rem;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: var(--hero-overlay);

    @media (max-width: 1023px) {
      background: var(--hero-overlay-mobile);
    }
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 1280px;
    margin: 0 auto;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;

    @media (min-width: 1024px) {
      grid-template-columns: 7fr 5fr;
    }
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .hero-headline {
    font-family: 'Noto Serif', Georgia, serif;
    font-size: clamp(3rem, 8vw, 5.5rem);
    color: var(--color-on-surface);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin: 0;

    em {
      color: var(--color-primary);
      font-style: italic;
    }
  }

  .hero-body {
    font-size: 1.125rem;
    color: var(--color-on-surface-variant);
    line-height: 1.7;
    max-width: 52ch;
    margin: 0;
    font-weight: 400;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .hero-card-wrap {
    position: relative;

    @media (max-width: 1023px) {
      display: none;
    }
  }

  .hero-ship-card {
    position: relative;
    border-radius: 1.5rem;
    overflow: hidden;
    box-shadow: 0 24px 64px var(--color-shadow-lg);

    &::before {
      content: '';
      position: absolute;
      inset: -0.5rem;
      background: var(--color-tint);
      border-radius: 2rem;
      transform: rotate(2deg);
      z-index: -1;
    }
  }

  .hero-ship-img {
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
    display: block;
  }

  .hero-detail-badge {
    position: absolute;
    bottom: -1.5rem;
    left: -1.5rem;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.875rem 1.5rem;
    border-radius: 9999px;
    box-shadow: 0 10px 32px var(--color-shadow-md);
    border: 1px solid var(--color-border-strong);

    .badge-ship {
      font-family: 'Noto Serif', serif;
      font-style: italic;
      font-size: 1.125rem;
      font-weight: 600;
      color: var(--color-primary);
    }

    .badge-sparkle {
      font-size: 0.625rem;
      color: var(--color-secondary);
      line-height: 1;
    }

    .badge-dates {
      font-family: 'Manrope', system-ui, sans-serif;
      font-size: 1rem;
      font-weight: 600;
      color: var(--color-secondary);
    }
  }
</style>
