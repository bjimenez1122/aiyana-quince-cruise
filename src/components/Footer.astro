---
const currentYear = new Date().getFullYear()
---

<footer class="site-footer">
  <div class="footer-lead">
    <div class="brand-mark-sm" aria-hidden="true">
      <picture>
        <source srcset="/logo_light.svg" media="(prefers-color-scheme: light)" />
        <img src="/logo_dark.svg" alt="" width="20" height="20" />
      </picture>
    </div>
    <span>&copy; {currentYear} — made with love by <a href="https://github.com/bjimenez1122">Bryan Jimenez-Rojas</a></span>
  </div>

  <div class="footer-meta">Aug 28 – Sep 2, 2026 · Disney Fantasy</div>
</footer>

<style lang="scss">
  .site-footer {
    padding: 48px 0 60px;
    border-top: 1px solid var(--line);
    color: var(--ink-mute);
    font-size: 12.5px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 18px;
    position: relative;
    z-index: 2;
  }

  .footer-lead {
    display: flex;
    align-items: center;
    gap: 10px;

    a {
      color: var(--gold);
      text-decoration: none;

      &:hover {
        text-decoration: underline;
      }
    }
  }

  .brand-mark-sm {
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;

    img {
      width: 100%;
      height: 100%;
      display: block;
    }
  }
</style>
