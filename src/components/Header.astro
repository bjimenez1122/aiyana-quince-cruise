---
import { SkipLink } from 'accessible-astro-components'

const navLinks = [
  { href: '/ship', label: 'The Ship' },
  { href: '/itinerary', label: 'Itinerary' },
  { href: '/booking', label: 'Booking' },
  { href: '/faq', label: 'FAQ' },
]

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/'
const isActive = (href: string) => pathname === href || pathname.startsWith(href + '/')
---

<SkipLink />
<nav class="nav" aria-label="Main navigation">
  <a class="brand" href="/" aria-label="Aiyana's Quinceañera at Sea — Home">
    <div class="brand-mark">
      <picture>
        <source srcset="/logo_light.svg" media="(prefers-color-scheme: light)" />
        <img src="/logo_dark.svg" alt="" width="28" height="28" />
      </picture>
    </div>
  </a>

  <div class="menu" id="desktop-menu">
    {navLinks.map(({ href, label }) => (
      <a href={href} class={isActive(href) ? 'active' : ''} aria-current={isActive(href) ? 'page' : undefined}>
        {label}
      </a>
    ))}
    <a class="cta" href="/booking">Reserve ✦</a>
  </div>

  <button
    class="mobile-toggle"
    id="mobile-nav-toggle"
    aria-expanded="false"
    aria-controls="mobile-nav"
    aria-label="Toggle menu"
    type="button"
  >
    <span class="bar"></span>
    <span class="bar"></span>
    <span class="bar"></span>
  </button>
</nav>

<nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation" hidden>
  <ul>
    <li><a href="/" class={pathname === '/' ? 'active' : ''}>Home</a></li>
    {navLinks.map(({ href, label }) => (
      <li><a href={href} class={isActive(href) ? 'active' : ''}>{label}</a></li>
    ))}
    <li><a href="/booking" class="cta">Reserve ✦</a></li>
  </ul>
</nav>

<script>
  const toggle = document.getElementById('mobile-nav-toggle')
  const mobileNav = document.getElementById('mobile-nav')

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true'
    toggle.setAttribute('aria-expanded', String(!expanded))
    if (expanded) {
      mobileNav?.setAttribute('hidden', '')
    } else {
      mobileNav?.removeAttribute('hidden')
    }
  })

  const desktopMql = window.matchMedia('(min-width: 720px)')
  const handleBreakpoint = (e: MediaQueryListEvent | MediaQueryList) => {
    if (e.matches) {
      toggle?.setAttribute('aria-expanded', 'false')
      mobileNav?.setAttribute('hidden', '')
    }
  }
  desktopMql.addEventListener('change', handleBreakpoint)
</script>

<style lang="scss">
  .nav {
    position: relative;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 0;
    gap: 16px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    color: var(--ink);
  }

  .brand-mark {
    flex: 0 0 44px;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;

    img {
      width: 100%;
      height: 100%;
      display: block;
    }
  }

  .menu {
    display: flex;
    align-items: center;
    gap: 28px;

    @media (max-width: 719px) {
      display: none;
    }
  }

  .menu a {
    position: relative;
    color: var(--ink-soft);
    text-decoration: none;
    font-size: 13.5px;
    letter-spacing: 0.2px;
    padding: 4px 0;
    transition: color 0.2s;
  }

  .menu a:hover,
  .menu a.active {
    color: var(--gold);
  }

  .menu a.active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 1px;
    background: var(--gold);
  }

  .menu a.cta {
    color: var(--bg);
    background: var(--gold);
    padding: 9px 18px;
    border-radius: 999px;
    font-weight: 500;
  }

  .menu a.cta::after {
    display: none;
  }

  .mobile-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 10px 8px;
    width: 44px;
    height: 44px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;

    @media (max-width: 719px) {
      display: flex;
    }

    .bar {
      display: block;
      width: 22px;
      height: 2px;
      background: var(--gold);
      border-radius: 1px;
      transition: all 0.25s;
    }

    &[aria-expanded='true'] .bar:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    &[aria-expanded='true'] .bar:nth-child(2) {
      opacity: 0;
    }

    &[aria-expanded='true'] .bar:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }

  .mobile-nav {
    position: relative;
    z-index: 5;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--panel);
    backdrop-filter: blur(10px);
    margin-top: 4px;
    margin-bottom: 8px;

    @media (min-width: 720px) {
      display: none;
    }

    ul {
      list-style: none;
      margin: 0;
      padding: 12px 18px;
      display: flex;
      flex-direction: column;
    }

    a {
      display: block;
      font-family: var(--font-family-display);
      font-style: italic;
      font-size: 18px;
      color: var(--ink);
      text-decoration: none;
      padding: 12px 0;
      border-bottom: 1px solid var(--line);
    }

    a.active {
      color: var(--gold);
    }

    a.cta {
      color: var(--gold);
      font-family: var(--font-family-body);
      font-style: normal;
      font-size: 13.5px;
      letter-spacing: 0.3px;
    }

    li:last-child a {
      border-bottom: none;
    }
  }
</style>
