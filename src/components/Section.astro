---
interface Props {
  rule?: boolean
  bleed?: boolean
  class?: string
}
const { rule = true, bleed = false, class: extraClass = '' } = Astro.props
---

<section class:list={['section', extraClass, { bleed }]}>
  {bleed ? <slot /> : <div class="section-inner"><slot /></div>}
  {rule && <hr class="section-rule" aria-hidden="true" />}
</section>

<style lang="scss">
  .section {
    padding-bottom: 0;
  }

  .section-inner {
    max-width: var(--content-w);
    margin: 0 auto;
    padding-inline: var(--space-md);
  }

  .section-rule {
    border: 0;
    height: 1px;
    background: var(--gold);
    opacity: 0.65;
    width: 50%;
    margin: var(--space-lg) auto 0;
  }
</style>
