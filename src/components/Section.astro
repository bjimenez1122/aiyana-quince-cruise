---
type Width = 'default' | 'wide' | 'bleed'

interface Props {
  rule?: boolean
  width?: Width
  tight?: boolean
  class?: string
}

const { rule = true, width = 'default', tight = false, class: extraClass = '' } = Astro.props
const isBleed = width === 'bleed'
---

<section class:list={['section', extraClass, `width-${width}`, { tight }]}>
  {isBleed ? <slot /> : <div class="section-inner"><slot /></div>}
  {rule && <hr class="section-rule" aria-hidden="true" />}
</section>

<style lang="scss">
  .section {
    padding-bottom: 0;
  }

  .section.tight {
    padding-top: 0;
  }

  .section-inner {
    margin: 0 auto;
    padding-inline: var(--space-sm);
  }

  .width-default .section-inner {
    max-width: var(--content-w);
  }

  .width-wide .section-inner {
    max-width: var(--content-w-wide);
  }

  .section-rule {
    border: 0;
    height: 1px;
    background: var(--gold);
    opacity: 0.65;
    width: 50%;
    margin: var(--space-lg) auto 0;
  }
</style>
