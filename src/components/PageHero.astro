---
import Section from './Section.astro'

interface Props {
  eyebrow?: string
  lede?: string
}

const { eyebrow, lede } = Astro.props
---

<Section class="page-hero" rule={false}>
  <header class="page-hero-head">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1 class="page-hero-title"><slot /></h1>
    {lede && <p class="page-hero-lede">{lede}</p>}
  </header>
</Section>

<style lang="scss">
  .page-hero-head {
    text-align: center;
  }

  .page-hero-head .eyebrow {
    display: block;
    margin-bottom: var(--space-sm);
  }

  .page-hero-title {
    font-family: var(--font-family-display);
    font-style: normal;
    font-weight: 500;
    font-size: clamp(40px, 5vw, 64px);
    line-height: 1.05;
    letter-spacing: -0.015em;
    color: var(--ink);
    margin: 0;
  }

  .page-hero-title :global(em) {
    font-style: normal;
    color: inherit;
    font-weight: inherit;
  }

  .page-hero-lede {
    font-family: var(--font-family-body);
    font-size: 17px;
    line-height: 1.55;
    color: var(--ink-soft);
    margin: var(--space-md) auto 0;
    max-width: 48ch;
  }
</style>
