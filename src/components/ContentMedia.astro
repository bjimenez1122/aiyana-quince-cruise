---
import { Media } from 'accessible-astro-components'

const { imgSrc } = Astro.props
---

<section>
  <div class="container">
    <div class="content">
      <div class="header">
        <slot name="header" />
      </div>
      <Media class="image" src={imgSrc} />
      <div class="text-content space-content">
        <slot />
      </div>
    </div>
  </div>
</section>

<style lang="scss" is:global>
  @use '../assets/scss/base/breakpoint' as *;
  section {
    margin: 2rem 0;

    .container {
      padding: 0 2rem;

      @include breakpoint(medium) {
        padding: 0 6rem;
      }

      .content {
        display: grid;
        grid-template-columns: repeat(1, minmax(0, 1fr));
        gap: 2rem;

        .header {
          text-align: center;
        }

        @include breakpoint(large) {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          .header {
            grid-column: span 2;
            text-align: start;
          }
        }

        .text-content {
          display: flex;
          flex-direction: column;
          justify-content: center;
          gap: 0;

          h3 {
            margin-top: 0;
          }
        }
      }

      .image {
        border-radius: 0.5rem;
      }
    }
  }
</style>
