---
import '@astrojs/tailwind/base.css'
import '../assets/scss/globals.scss'
import SiteMeta from '../components/SiteMeta.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

const {
  title = 'Astro',
  description = "Aiyana's Quinceañera at Sea — A Cruise Celebration",
  url = Astro.site,
  image = 'social-preview-image.jpg',
  author = 'Bryan Jimenez-Rojas',
} = Astro.props
---

<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,300..800;1,300..800&family=Petrona:ital,wght@0,400..900;1,400..900&display=swap"
      rel="stylesheet"
    />

    <!-- favicon -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <SiteMeta title={title} description={description.substring(0, 100)} url={url} image={image} author={author} />
  </head>
  <body class="font-body">
    <div class="site">
      <div class="wrap">
        <Header />
        <main id="main-content">
          <slot />
        </main>
        <Footer />
      </div>
    </div>
    <style lang="scss" is:global>
      :root {
        --font-family-display: 'Petrona', Georgia, serif;
        --font-family-body: 'Hanken Grotesk', system-ui, sans-serif;
        --font-family-label: 'Hanken Grotesk', system-ui, sans-serif;

        // semantic tokens (dark — default)
        --bg: #0b1422;
        --bg-2: #16253d;
        --panel: rgba(234, 217, 160, 0.06);
        --ink: #f5efdc;
        --ink-soft: #c7bfa6;
        --ink-mute: #8f8977;
        --gold: #ead9a0;
        --gold-deep: #caa84f;
        --green: oklch(0.62 0.13 152);
        --rose: #d598b2;
        --line: rgba(234, 217, 160, 0.22);
        --line-strong: rgba(234, 217, 160, 0.5);
        --hover-shadow: rgba(0, 0, 0, 0.2);

        // layout tokens (theme-agnostic)
        --content-w: 720px;
        --space-xs: 8px;
        --space-sm: 14px;
        --space-md: 24px;
        --space-lg: 48px;
        --space-xl: 96px;
      }

      @media (prefers-color-scheme: light) {
        :root {
          --bg: #faf3e2;
          --bg-2: #fffaef;
          --panel: #fffaef;
          --ink: #1a2640;
          --ink-soft: #4a5473;
          --ink-mute: #8a8472;
          --gold: #a87f2a;
          --gold-deep: #7c5b13;
          --green: oklch(0.42 0.12 150);
          --rose: #a8466b;
          --line: rgba(26, 38, 64, 0.18);
          --line-strong: rgba(26, 38, 64, 0.45);
          --hover-shadow: rgba(26, 38, 64, 0.15);
        }
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
      }

      body {
        background: var(--bg);
        color: var(--ink);
        font-family: var(--font-family-body);
        font-weight: 400;
        font-size: 17px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;

        main {
          position: relative;
          z-index: 2;
        }
      }

      ::selection {
        background: var(--gold);
        color: var(--bg);
      }

      :focus-visible {
        outline: 2px solid var(--green);
        outline-offset: 3px;
        border-radius: 2px;
      }

      .site {
        position: relative;
        overflow: hidden;
      }

      .wrap {
        max-width: 1240px;
        margin: 0 auto;
        padding: 0 28px;

        @media (max-width: 560px) {
          padding: 0 18px;
        }
      }

      // ─── shared primitives used across pages ─────────────────
      .eyebrow {
        font-family: var(--font-family-label);
        font-size: 16px;
        letter-spacing: 3.5px;
        color: var(--gold);
        text-transform: uppercase;
      }

      .btn {
        display: inline-block;
        padding: 13px 26px;
        border-radius: 999px;
        font-family: var(--font-family-body);
        font-size: 13.5px;
        font-weight: 500;
        letter-spacing: 0.3px;
        text-decoration: none;
        border: 1.5px solid var(--gold);
        color: var(--gold);
        background: transparent;
        transition: all 0.2s;

        &.primary {
          background: var(--gold);
          color: var(--bg);
        }

        &:hover {
          transform: translateY(-1px);
          box-shadow: 0 10px 24px var(--hover-shadow);
        }
      }

      .sec-head {
        text-align: center;
        margin-bottom: 56px;

        .eyebrow {
          display: block;
          margin-bottom: 10px;
        }

        h2 {
          font-family: var(--font-family-display);
          font-style: italic;
          font-weight: 500;
          font-size: clamp(40px, 5vw, 64px);
          line-height: 1;
          margin: 0;
          letter-spacing: -0.5px;

          em {
            color: var(--gold);
            font-weight: 600;
          }
        }

        p {
          color: var(--ink-soft);
          max-width: 520px;
          margin: 14px auto 0;
          font-size: 16px;
        }
      }

      // decorative gold line ornament used by closing blocks
      .orn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        color: var(--gold);
        margin: 8px 0;

        &::before,
        &::after {
          content: '';
          flex: 1;
          max-width: 80px;
          height: 1px;
          background: var(--line-strong);
        }
      }

      main > section {
        position: relative;
        z-index: 2;
        padding: 50px 0;

        @media (max-width: 560px) {
          padding: 72px 0;
        }
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border-width: 0;
      }
    </style>
  </body>
</html>
