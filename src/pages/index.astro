---
import { Image } from 'astro:assets'
import DefaultLayout from '../layouts/DefaultLayout.astro'
import KeepExploring from '../components/KeepExploring.astro'
import Section from '../components/Section.astro'
import heroBg from '../assets/photos/disneyfantasycastaway.avif'
import aiyanaPortrait from '../assets/photos/aiyana-daisy.jpg'

const targetDate = new Date('2026-08-28T00:00:00').getTime()
const daysUntilTarget = Math.max(0, Math.ceil((targetDate - Date.now()) / 86400000))

const itinerary = [
  { day: 1, date: 'AUG 28', port: 'Port Canaveral' },
  { day: 2, date: 'AUG 29', port: 'Castaway Cay' },
  { day: 3, date: 'AUG 30', port: 'Lookout Cay' },
  { day: 4, date: 'AUG 31', port: 'Nassau' },
  { day: 5, date: 'SEP 1', port: "At Sea · Aiyana's Birthday ✦", birthday: true },
  { day: 6, date: 'SEP 2', port: 'Port Canaveral' },
]
---

<DefaultLayout title="Home">
  <Section width="bleed" rule={false} tight>
    <div class="hero">
    <div class="hero-bg" aria-hidden="true">
      <Image src={heroBg} alt="" class="hero-img" />
      <div class="hero-overlay"></div>
    </div>

    <h1>Aiyana's Quinceañera at Sea</h1>

    <div class="hero-rule" aria-hidden="true"></div>

    <a class="cd-hero" href="/booking" aria-label="Reserve your cabin">
      <span class="cdh-line">
        <b class="cdh-days" id="cd-days" aria-live="polite">{daysUntilTarget}</b>
        <span class="cdh-days-mark">days</span>
      </span>
      <div class="cd-row" aria-hidden="true">
        <span class="cd-time" id="cd-hours">
          <span class="cd-pair">
            <span class="cd-cell"><span class="cd-static-top">0</span><span class="cd-static-bot">0</span><span class="cd-overlay"><span class="cd-overlay-top">0</span><span class="cd-overlay-bot">0</span></span></span>
            <span class="cd-cell"><span class="cd-static-top">0</span><span class="cd-static-bot">0</span><span class="cd-overlay"><span class="cd-overlay-top">0</span><span class="cd-overlay-bot">0</span></span></span>
          </span>
          <span class="cd-label">hrs</span>
        </span>
        <span class="cd-sep">·</span>
        <span class="cd-time" id="cd-minutes">
          <span class="cd-pair">
            <span class="cd-cell"><span class="cd-static-top">0</span><span class="cd-static-bot">0</span><span class="cd-overlay"><span class="cd-overlay-top">0</span><span class="cd-overlay-bot">0</span></span></span>
            <span class="cd-cell"><span class="cd-static-top">0</span><span class="cd-static-bot">0</span><span class="cd-overlay"><span class="cd-overlay-top">0</span><span class="cd-overlay-bot">0</span></span></span>
          </span>
          <span class="cd-label">min</span>
        </span>
        <span class="cd-sep">·</span>
        <span class="cd-time" id="cd-seconds">
          <span class="cd-pair">
            <span class="cd-cell"><span class="cd-static-top">0</span><span class="cd-static-bot">0</span><span class="cd-overlay"><span class="cd-overlay-top">0</span><span class="cd-overlay-bot">0</span></span></span>
            <span class="cd-cell"><span class="cd-static-top">0</span><span class="cd-static-bot">0</span><span class="cd-overlay"><span class="cd-overlay-top">0</span><span class="cd-overlay-bot">0</span></span></span>
          </span>
          <span class="cd-label">sec</span>
        </span>
      </div>
    </a>
    </div>
  </Section>

  <Section class="route-section">
    <header class="route-head">
      <h2 class="route-title">Itinerary Overview</h2>
      <p class="route-lede">A five-night Bahamian voyage on the Disney Fantasy.</p>
    </header>
    <ol class="route-list" aria-label="Voyage timeline">
      {itinerary.map(s => (
        <li class:list={['route-row', { 'is-birthday': s.birthday }]}>
          <a class="route-link" href="/itinerary">
            <span class="route-day">Day {s.day}</span>
            <span class="route-date">{s.date}</span>
            <span class="route-port">{s.port}</span>
          </a>
        </li>
      ))}
    </ol>
    <p class="route-cta-row">
      <a class="route-cta" href="/itinerary">View full itinerary</a>
    </p>
  </Section>

  <Section class="note-section" rule={false}>
    <header class="note-head">
      <span class="eyebrow">A note from us</span>
    </header>
    <div class="note-pair">
      <figure class="note-photo">
        <Image src={aiyanaPortrait} alt="Aiyana" />
      </figure>
      <p class="note-body">
        Aiyana is looking forward to celebrating her birthday with her closest family and friends on her first
        Disney cruise. We hope you can join us as we celebrate and set sail on the Disney Fantasy!
      </p>
    </div>
  </Section>

  <KeepExploring current="home" />
</DefaultLayout>

<script>
  const target = new Date('2026-08-28T00:00:00').getTime()

  function setFlipDigit(cellEl: Element, newDigit: string) {
    const top = cellEl.querySelector('.cd-static-top') as HTMLElement | null
    if (!top || top.textContent === newDigit) return
    const bot = cellEl.querySelector('.cd-static-bot') as HTMLElement
    const overlay = cellEl.querySelector('.cd-overlay') as HTMLElement
    const ovTop = cellEl.querySelector('.cd-overlay-top') as HTMLElement
    const ovBot = cellEl.querySelector('.cd-overlay-bot') as HTMLElement

    overlay.classList.add('flip')
    top.textContent = newDigit
    ovBot.textContent = newDigit

    function finish() {
      overlay.classList.remove('flip')
      bot.textContent = newDigit
      ovTop.textContent = newDigit
      overlay.removeEventListener('animationend', finish)
    }
    overlay.addEventListener('animationend', finish)
  }

  function setFlipPair(containerEl: Element, value: number) {
    const padded = String(value).padStart(2, '0')
    const cells = containerEl.querySelectorAll('.cd-cell')
    if (cells.length < 2) return
    setFlipDigit(cells[0], padded[0])
    setFlipDigit(cells[1], padded[1])
  }

  function updateCountdown() {
    const now = Date.now()
    const diff = target - now
    const days = document.getElementById('cd-days')
    const hoursEl = document.getElementById('cd-hours')
    const minutesEl = document.getElementById('cd-minutes')
    const secondsEl = document.getElementById('cd-seconds')
    if (!days || !hoursEl || !minutesEl || !secondsEl) return

    if (diff <= 0) {
      days.textContent = '0'
      setFlipPair(hoursEl, 0)
      setFlipPair(minutesEl, 0)
      setFlipPair(secondsEl, 0)
      return
    }

    const d = Math.floor(diff / (1000 * 60 * 60 * 24))
    const h = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60))
    const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60))
    const s = Math.floor((diff % (1000 * 60)) / 1000)

    days.textContent = String(d)
    setFlipPair(hoursEl, h)
    setFlipPair(minutesEl, m)
    setFlipPair(secondsEl, s)
  }

  updateCountdown()
  setInterval(updateCountdown, 1000)
</script>

<style lang="scss">
  // ─── hero ─────────────────────────────────────────────────
  .hero {
    position: relative;
    z-index: 2;
    padding: 32px 0 48px;
    text-align: center;

    > *:not(.hero-bg) {
      position: relative;
      z-index: 1;
    }
  }

  .hero-bg {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    height: 100%;
    overflow: hidden;
    z-index: 0;
    pointer-events: none;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 38%;
    display: block;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(250, 243, 226, 0.32) 0%, rgba(250, 243, 226, 0.72) 100%);
  }

  @media (prefers-color-scheme: dark) {
    .hero-overlay {
      background: linear-gradient(180deg, rgba(11, 20, 34, 0.35) 0%, rgba(11, 20, 34, 0.78) 100%);
    }
  }

  .hero-eyebrow {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 14px;
    font-family: var(--font-family-body);
    font-weight: 600;
    font-size: 16px;
    letter-spacing: 2.6px;
    color: var(--gold);
    text-transform: uppercase;
    padding: 0 20px;
  }

  .hero-eyebrow .sep {
    color: var(--ink-mute);
  }

  @media (max-width: 640px) {
    .hero-eyebrow {
      flex-direction: column;
      align-items: center;
    }
    .hero-eyebrow .sep {
      display: none;
    }
  }

  .hero h1 {
    font-family: var(--font-family-display);
    font-style: normal;
    font-weight: 500;
    font-size: clamp(40px, 5vw, 64px);
    line-height: 1.15;
    letter-spacing: -0.012em;
    margin: 6px 0 0;
    color: var(--ink);
  }

  .hero-rule {
    width: 56px;
    height: 1px;
    background: var(--gold);
    opacity: 0.65;
    margin: 24px auto;
  }

  .cd-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 18px 20px 8px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.4s var(--animation-timing, cubic-bezier(0.165, 0.84, 0.44, 1));
  }

  .cd-hero:focus-visible { outline: none; }

  .cdh-line {
    display: inline-flex;
    align-items: center;
    gap: 14px;
  }

  .cdh-days {
    display: inline-block;
    font-family: var(--font-family-display);
    font-style: normal;
    font-weight: 500;
    font-size: clamp(102px, 18.7vw, 170px);
    line-height: 0.78;
    letter-spacing: -0.06em;
    color: var(--ink);
    font-feature-settings: 'tnum' 1, 'lnum' 1;
    transition: color 0.25s var(--animation-timing, cubic-bezier(0.165, 0.84, 0.44, 1));
  }

  .cdh-days-mark {
    font-family: var(--font-family-display);
    font-weight: 400;
    font-size: 40px;
    letter-spacing: 0.3px;
    line-height: 1;
    color: var(--gold);
  }

  .cd-hero .cd-row {
    margin-top: var(--space-md);
  }

  .cd-cta-arrow {
    display: inline-block;
    margin-left: 6px;
    transform: translateX(0);
    transition: transform 0.3s var(--animation-timing, cubic-bezier(0.165, 0.84, 0.44, 1));
  }

  .cd-hero:hover .cd-cta-arrow,
  .cd-hero:focus-visible .cd-cta-arrow {
    transform: translateX(6px);
  }

  .cd-hero:hover .cdh-days,
  .cd-hero:focus-visible .cdh-days {
    color: var(--gold);
  }

  @media (max-width: 720px) {
    .cdh-side {
      grid-template-columns: 1fr;
      gap: 20px;
      text-align: center;
    }
    .cdh-r { align-items: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cd-hero,
    .cdh-days,
    .cd-cta-arrow {
      transition: none;
    }
  }

  .cd-row {
    margin-top: 18px;
    display: inline-flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 14px;
    font-family: var(--font-family-body);
    font-weight: 500;
    font-size: 20px;
    letter-spacing: 2.4px;
    color: var(--ink-soft);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .cd-time {
    display: inline-flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 9px;
  }

  @media (max-width: 480px) {
    .cd-row {
      font-size: 14px;
      gap: 9px;
      letter-spacing: 1.8px;
    }
    .cd-time { gap: 6px; }
    .cd-row .cd-sep { font-size: 14px; }
    .cd-pair { gap: 2px; }
    .cd-cell { font-size: 22px; }
  }

  .cd-row .cd-sep {
    color: var(--gold);
    font-size: 18px;
  }

  .cd-pair {
    display: inline-flex;
    gap: 3px;
  }

  .cd-cell {
    position: relative;
    display: inline-block;
    width: 0.66em;
    height: 1.5em;
    font-family: var(--font-family-display);
    font-style: italic;
    font-weight: 500;
    font-size: 30px;
    line-height: 1;
    color: var(--ink);
    letter-spacing: 0;
    text-transform: none;
    font-feature-settings: 'tnum' 1, 'lnum' 1;
    border-radius: 5px;
    overflow: hidden;
    box-shadow: inset 0 0 0 1px var(--line);
    perspective: 400px;
  }

  .cd-static-top,
  .cd-static-bot,
  .cd-overlay-top,
  .cd-overlay-bot {
    position: absolute;
    left: 0;
    right: 0;
    height: 50%;
    overflow: hidden;
    text-align: center;
    background: var(--bg-2);
  }

  .cd-static-top,
  .cd-overlay-top {
    top: 0;
    line-height: 1.5;
    border-bottom: 1px solid rgba(234, 217, 160, 0.16);
  }

  .cd-static-bot,
  .cd-overlay-bot {
    bottom: 0;
    line-height: 0;
  }

  .cd-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .cd-overlay-top { transform-origin: bottom; }
  .cd-overlay-bot { transform-origin: top; }

  .cd-overlay.flip .cd-overlay-top {
    animation: cd-flip-top 0.6s linear;
  }

  .cd-overlay.flip .cd-overlay-bot {
    animation: cd-flip-bot 0.6s linear;
  }

  @keyframes cd-flip-top {
    0%        { transform: rotateX(0deg); }
    50%, 100% { transform: rotateX(-90deg); }
  }

  @keyframes cd-flip-bot {
    0%, 50% { transform: rotateX(-90deg); }
    100%    { transform: rotateX(0deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .cd-overlay.flip .cd-overlay-top,
    .cd-overlay.flip .cd-overlay-bot {
      animation-duration: 0.01s;
    }
  }

  // ─── route ────────────────────────────────────────────────
  .route-head {
    margin-bottom: var(--space-lg);
    text-align: left;
  }

  .route-title {
    font-family: var(--font-family-display);
    font-style: normal;
    font-weight: 500;
    font-size: clamp(32px, 4vw, 48px);
    line-height: 1.1;
    letter-spacing: -0.012em;
    color: var(--ink);
    margin: 0;
  }

  .route-lede {
    font-family: var(--font-family-body);
    font-size: 17px;
    line-height: 1.55;
    color: var(--ink-soft);
    margin: var(--space-md) 0 0;
    max-width: 56ch;
  }

  .route-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .route-row {
    border-bottom: 1px solid var(--line);
  }

  .route-link {
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: baseline;
    column-gap: var(--space-md);
    padding: var(--space-md) 0;
    text-decoration: none;
    color: inherit;
    transition: color 0.2s ease;

    &:hover .route-port,
    &:focus-visible .route-port {
      color: var(--gold);
    }

    &:focus-visible {
      outline: none;

      .route-day {
        color: var(--gold-deep);
      }
    }
  }

  .route-day {
    font-family: var(--font-family-body);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--ink-mute);
    min-width: 56px;
  }

  .route-date {
    font-family: var(--font-family-label);
    font-size: 12px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--ink-mute);
    min-width: 64px;
  }

  .route-port {
    font-family: var(--font-family-display);
    font-style: normal;
    font-weight: 500;
    font-size: clamp(19px, 1.8vw, 22px);
    line-height: 1.25;
    color: var(--ink);
    transition: color 0.2s ease;
  }

  .route-row.is-birthday .route-port {
    font-weight: 600;
  }

  .route-cta-row {
    margin: var(--space-lg) 0 0;
  }

  .route-cta {
    font-family: var(--font-family-body);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    padding-bottom: 4px;
    transition: color 0.2s ease;

    &:hover,
    &:focus-visible {
      color: var(--gold-deep);
      border-bottom: 1px solid var(--gold);
    }
  }

  @media (max-width: 560px) {
    .route-link {
      grid-template-columns: auto 1fr;
      column-gap: var(--space-sm);
      row-gap: 2px;
      padding: var(--space-md) 0;
    }

    .route-date {
      grid-column: 1;
      min-width: 56px;
    }

    .route-port {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: center;
    }
  }

  // ─── personal note ────────────────────────────────────────
  .note-head {
    margin-bottom: var(--space-md);
    text-align: center;
  }

  .note-head .eyebrow {
    display: block;
  }

  .note-pair {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
  }

  .note-photo {
    margin: 0;
    max-width: 280px;
  }

  .note-photo img {
    width: 100%;
    height: auto;
    display: block;
  }

  .note-body {
    font-family: var(--font-family-display);
    font-style: normal;
    font-weight: 400;
    font-size: clamp(20px, 2.1vw, 26px);
    line-height: 1.45;
    color: var(--ink);
    max-width: 48ch;
    margin: 0;
    text-align: center;
  }

  @media (min-width: 640px) {
    .note-pair {
      flex-direction: row;
      align-items: center;
      gap: var(--space-xl);
    }

    .note-photo {
      flex: 0 0 auto;
      max-width: 240px;
    }

    .note-body {
      text-align: left;
      flex: 1 1 auto;
    }
  }

  // ─── responsive ───────────────────────────────────────────
  @media (max-width: 760px) {
    .hero {
      padding: 28px 0 80px;
    }

    .hero-rule {
      margin: 32px auto;
    }

    .cd-hero #cd-days {
      letter-spacing: -0.03em;
    }
  }
</style>
