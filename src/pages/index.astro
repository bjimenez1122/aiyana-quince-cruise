---
import DefaultLayout from '../layouts/DefaultLayout.astro'
import Hero from '../components/Hero.astro'
import Welcome from '../components/Welcome.astro'
import Feature from '../components/Feature.astro'
import Counter from '../components/Counter.astro'
import ContentMedia from '../components/ContentMedia.astro'
import { Accordion, AccordionItem } from 'accessible-astro-components'
---

<DefaultLayout title="Home">
  <!-- <Hero /> -->
  <Welcome />
  <ContentMedia imgSrc='/captain-minnie.jpg'>
    <h2 slot="header" class="text-4xl font-bold">✨ Join Us Aboard the Disney Fantasy ✨</h2>
    <p>
      We're setting sail on a magical journey to celebrate a very special occasion — Aiyana's 15<sup>th</sup> birthday! 🌟
    </p>
    <p>
      We would be overjoyed to have you join us on this unforgettable adventure filled with laughter, memories,
      and a touch of pixie dust. Whether you're a seasoned cruiser or new to the magic of Disney at sea, this
      trip promises joy for all ages.
    </p>
    <p>This site will be your enchanted guide as we finalize details, share tips, and sprinkle in surprises. Stay tuned — there's more magic to come!</p>
  </ContentMedia>
  <ContentMedia imgSrc='/stateroom.jpg' reverseImg={false}>
    <h2 slot="header" class="text-4xl font-bold">📅 Booking Your Magical Getaway</h2>
    <ul class="list-disc list-inside">
      <li><strong>Dates:</strong> August 28 – September 2, 2026</li>
      <li><strong>Itinerary:</strong> 5-Night Bahamian Cruise from Port Canaveral</li>
      <li><strong>Ship:</strong> Disney Fantasy</li>
      <li>
        Book online at <strong><a href="https://disneycruise.disney.go.com/">disneycruise.disney.go.com</a></strong> or call <strong><a href="tel:800-951-3532">(800) 951-3532</a></strong>
      </li>
      <li>
        Select <strong>late dining (8:15 PM)</strong> and share your reservation number with Jackie so we can coordinate group plans
      </li>
      <li>The birthday girl will be in stateroom <strong>8532</strong> — book nearby if you'd like to stay close!</li>
    </ul>
    <h3 class="text-2xl font-semibold">💰 Sample Pricing (as of May 12, 2025)</h3>
    <p><strong>For 2 Adults + 2 Children:</strong></p>
    <ul class="list-disc list-inside">
      <li>Inside Stateroom: $4,545</li>
      <li>Oceanview Stateroom: $4,775</li>
      <li>Verandah Stateroom: $5,064</li>
    </ul>
    <p><strong>For 2 Adults:</strong></p>
    <ul class="list-disc list-inside">
      <li>Inside Stateroom: $2,694</li>
      <li>Oceanview Stateroom: $2,874</li>
      <li>Verandah Stateroom: $3,194</li>
    </ul>
    <p class="italic">A 10% deposit secures your cabin. Final payment is due May 30, 2026 at 11:59 PM ET. Plans change? Cancellations are fully refundable until then — booking now locks in today’s price before availability shrinks!</p>
  </ContentMedia>
