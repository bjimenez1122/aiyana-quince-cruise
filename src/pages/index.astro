---
import DefaultLayout from '../layouts/DefaultLayout.astro'
---

<DefaultLayout title="Aiyana's Quinceañera at Sea">
  <!-- ─── HERO ─── -->
  <section class="hero" id="hero">
    <div class="hero-bg">
      <div class="hero-overlay"></div>
      <img
        src="/disneyfantasycastaway.avif"
        alt="Disney Fantasy cruise ship"
        class="hero-img"
      />
    </div>

    <div class="hero-content">
      <div class="hero-text">
        <h1 class="hero-headline">
          Aiyana's<br />
          <em>Quinceañera at Sea</em>
        </h1>
        <p class="hero-body">
          Once upon a voyage… join us on the Disney Fantasy for 5 enchanted nights through the Bahamas as we celebrate Aiyana's quinceañera.
        </p>
        <div class="hero-cta">
          <a href="#booking" class="btn-primary">View Booking Details</a>
          <a href="#itinerary" class="btn-ghost">See the Itinerary</a>
        </div>
      </div>

      <div class="hero-card-wrap">
        <div class="hero-ship-card">
          <img
            src="/captain-minnie.jpg"
            alt="Captain Minnie welcoming guests aboard"
            class="hero-ship-img"
          />
        </div>
        <div class="hero-detail-badge glass-panel">
          <span class="badge-ship">Disney Fantasy</span>
          <span class="badge-sparkle">✦</span>
          <span class="badge-dates">Aug 28 – Sep 2, 2026</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── COUNTDOWN ─── -->
  <section class="countdown-section">
    <div class="section-inner">
      <div class="countdown-header">
        <div>
          <h2 class="section-headline">We Set Sail In...</h2>
          <p class="section-body">Mark your calendars — August 28, 2026. We depart from Port Canaveral for five days of magic on the open sea.</p>
        </div>
        <span class="material-symbols-outlined countdown-icon" aria-hidden="true">water</span>
      </div>

      <div class="countdown-grid" id="countdown-grid">
        <div class="countdown-cell">
          <span class="countdown-num" id="cd-days">—</span>
          <span class="countdown-label">Days</span>
        </div>
        <div class="countdown-cell">
          <span class="countdown-num" id="cd-hours">—</span>
          <span class="countdown-label">Hours</span>
        </div>
        <div class="countdown-cell">
          <span class="countdown-num" id="cd-minutes">—</span>
          <span class="countdown-label">Minutes</span>
        </div>
        <div class="countdown-cell">
          <span class="countdown-num" id="cd-seconds">—</span>
          <span class="countdown-label">Seconds</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── EXPERIENCE ─── -->
  <section class="experience-section">
    <div class="section-inner">
      <div class="section-label-block">
        <em class="section-eyebrow">What Awaits</em>
        <h2 class="section-headline">A Ship Full of Magic</h2>
      </div>

      <div class="experience-grid">
        <div class="exp-card">
          <div class="exp-img-wrap">
            <img src="/aquaduck.jpg" alt="Disney Fantasy at sea" class="exp-img" />
          </div>
          <h3>The AquaDuck</h3>
          <p>Disney's signature water coaster — 765 feet of twists through a translucent tube that soars four decks above the waves and out over the open sea. A rush only the Fantasy can offer.</p>
        </div>
        <div class="exp-card">
          <div class="exp-img-wrap">
            <img src="/oceaneer-club.jpg" alt="Disney Fantasy Oceaneer Club" class="exp-img" />
          </div>
          <h3>Oceaneer Club &amp; Lab</h3>
          <p>A magical world just for kids. Play inside Andy's Room from Toy Story, laugh through Monsters Academy, sprinkle pixie dust in Pixie Hollow, and dive deep with Finding Nemo's Explorer Pod.</p>
        </div>
        <div class="exp-card">
          <div class="exp-img-wrap">
            <img src="/characters.jpg" alt="Disney characters greeting guests" class="exp-img" />
          </div>
          <h3>Broadway Shows &amp; Characters</h3>
          <p>Catch <em>Aladdin: A Musical Spectacular</em>, a 45-minute Broadway-style show at sea. Then hug Mickey, pose with the princesses, and gather autographs from Goofy, Chip 'n Dale and friends.</p>
        </div>
        <div class="exp-card">
          <div class="exp-img-wrap">
            <img src="/currents-bar.jpg" alt="Disney Fantasy Currents Bar" class="exp-img" />
          </div>
          <h3>Adults-Only Escape</h3>
          <p>Slip away to Europa, the grown-ups' district of lounges and clubs. Unwind at the Quiet Cove adult pool, Satellite Falls, or a serene afternoon at Senses Spa — your moment of calm amid the celebration.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── BOOKING ─── -->
  <section class="booking-section" id="booking">
    <div class="section-inner">
      <div class="booking-header">
        <div>
          <h2 class="section-headline">Select Your Stateroom</h2>
          <p class="section-body italic">Prices shown are sample rates from May 2025. Book early — availability shrinks as the date approaches.</p>
        </div>
        <span class="material-symbols-outlined booking-icon" aria-hidden="true">waves</span>
      </div>

      <div class="pricing-grid">
        <!-- Inside -->
        <div class="pricing-card">
          <div class="pricing-img-wrap">
            <img src="/inside-stateroom.jpg" alt="Interior stateroom" class="pricing-img" />
          </div>
          <div class="pricing-body">
            <div class="pricing-title-row">
              <h3>Inside Stateroom</h3>
            </div>
            <p>A cozy, well-appointed sanctuary featuring premium Disney linens. Perfect for those spending their days exploring the ship and ports.</p>
            <div class="pricing-tiers">
              <div class="pricing-tier">
                <span class="tier-guests">2 Adults + 2 Children</span>
                <span class="tier-price">$4,545</span>
              </div>
              <div class="pricing-tier">
                <span class="tier-guests">2 Adults</span>
                <span class="tier-price">$2,694</span>
              </div>
            </div>
            <a href="https://disneycruise.disney.go.com/" target="_blank" rel="noopener noreferrer" class="btn-booking">
              Book on Disney Cruise Line
              <span class="material-symbols-outlined">open_in_new</span>
            </a>
          </div>
        </div>

        <!-- Oceanview -->
        <div class="pricing-card">
          <div class="pricing-img-wrap">
            <img src="/oceanview-stateroom.jpg" alt="Oceanview stateroom" class="pricing-img" />
          </div>
          <div class="pricing-body">
            <div class="pricing-title-row">
              <h3>Oceanview Stateroom</h3>
            </div>
            <p>Wake up to the endless horizon with a private porthole window. Includes all the magic of an oceanview perspective.</p>
            <div class="pricing-tiers">
              <div class="pricing-tier">
                <span class="tier-guests">2 Adults + 2 Children</span>
                <span class="tier-price">$4,775</span>
              </div>
              <div class="pricing-tier">
                <span class="tier-guests">2 Adults</span>
                <span class="tier-price">$2,874</span>
              </div>
            </div>
            <a href="https://disneycruise.disney.go.com/" target="_blank" rel="noopener noreferrer" class="btn-booking">
              Book on Disney Cruise Line
              <span class="material-symbols-outlined">open_in_new</span>
            </a>
          </div>
        </div>

        <!-- Verandah -->
        <div class="pricing-card">
          <div class="pricing-img-wrap">
            <img src="/verandah-stateroom.jpg" alt="Verandah stateroom" class="pricing-img" />
          </div>
          <div class="pricing-body">
            <div class="pricing-title-row">
              <h3>Verandah Stateroom</h3>
            </div>
            <p>Wake up to fresh ocean air on your own private veranda and watch the world drift by in style.</p>
            <div class="pricing-tiers">
              <div class="pricing-tier">
                <span class="tier-guests">2 Adults + 2 Children</span>
                <span class="tier-price">$5,064</span>
              </div>
              <div class="pricing-tier">
                <span class="tier-guests">2 Adults</span>
                <span class="tier-price">$3,194</span>
              </div>
            </div>
            <a href="https://disneycruise.disney.go.com/" target="_blank" rel="noopener noreferrer" class="btn-booking">
              Book on Disney Cruise Line
              <span class="material-symbols-outlined">open_in_new</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Booking protocol callout -->
      <div class="booking-note">
        <span class="material-symbols-outlined booking-note-icon">anchor</span>
        <div>
          <p class="booking-note-title">Official Booking Details</p>
          <p class="booking-note-body">
            Book at <a href="https://disneycruise.disney.go.com/" target="_blank" rel="noopener noreferrer">disneycruise.disney.go.com</a> or call <a href="tel:800-951-3532">(800) 951-3532</a>.
            Select <strong>late dining (8:15 PM)</strong> and share your reservation number with Jackie so we can coordinate group plans.
            A 10% deposit secures your cabin — <strong>final payment due May 30, 2026</strong>. Fully refundable until then!
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── ITINERARY OVERVIEW ─── -->
  <section class="itinerary-section" id="itinerary">
    <div class="section-inner">
      <div class="section-label-block">
        <em class="section-eyebrow">The Route</em>
        <h2 class="section-headline">5-Night Bahamian Cruise</h2>
      </div>

      <div class="itinerary-list">
        <div class="itin-row">
          <div class="itin-day">Day 1 <span class="itin-date">Aug 28</span></div>
          <div class="itin-detail">
            <strong>Port Canaveral, FL</strong>
            <span>Embarkation — Board the Disney Fantasy</span>
          </div>
        </div>
        <div class="itin-row">
          <div class="itin-day">Day 2 <span class="itin-date">Aug 29</span></div>
          <div class="itin-detail">
            <strong>Nassau, Bahamas</strong>
            <span>Explore the vibrant capital of the Bahamas</span>
          </div>
        </div>
        <div class="itin-row">
          <div class="itin-day">Day 3 <span class="itin-date">Aug 30</span></div>
          <div class="itin-detail">
            <strong>Castaway Cay</strong>
            <span>Disney's private island paradise</span>
          </div>
        </div>
        <div class="itin-row">
          <div class="itin-day">Day 4 <span class="itin-date">Aug 31</span></div>
          <div class="itin-detail">
            <strong>At Sea</strong>
            <span>Enjoy onboard dining, entertainment, and the grand birthday celebration</span>
          </div>
        </div>
        <div class="itin-row">
          <div class="itin-day">Day 5 <span class="itin-date">Sep 1</span></div>
          <div class="itin-detail">
            <strong>At Sea</strong>
            <span>Final day to explore the ship's restaurants, pools, and shows</span>
          </div>
        </div>
        <div class="itin-row">
          <div class="itin-day">Day 6 <span class="itin-date">Sep 2</span></div>
          <div class="itin-detail">
            <strong>Port Canaveral, FL</strong>
            <span>Disembarkation — Until the next adventure!</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── FAQ ─── -->
  <section class="faq-section" id="faq">
    <div class="section-inner faq-grid">
      <div class="faq-heading">
        <em class="section-eyebrow">Good to Know</em>
        <h2 class="section-headline">Common Questions</h2>
        <p class="section-body">Everything you need to prepare for the trip. More questions? Reach out!</p>
      </div>

      <div class="faq-list">
        <details class="faq-item glass-panel">
          <summary>When should I book?</summary>
          <p>Book as soon as possible — Disney Cruise cabins fill up quickly! A 10% deposit secures your cabin, with final payment due May 30, 2026. Plans change? Cancellations are fully refundable until then, and booking now locks in today's price.</p>
        </details>
        <details class="faq-item glass-panel">
          <summary>What dining time should I select?</summary>
          <p>Please select <strong>late dining (8:15 PM)</strong> when booking. Share your reservation number with Jackie so we can coordinate and sit together as a group.</p>
        </details>
        <details class="faq-item glass-panel">
          <summary>Where is the birthday girl staying?</summary>
          <p>Aiyana will be in stateroom <strong>8532</strong>. Book a nearby stateroom if you'd like to stay close to the birthday girl!</p>
        </details>
        <details class="faq-item glass-panel">
          <summary>Do I need a passport?</summary>
          <p>A valid passport is strongly recommended for all guests. A birth certificate plus government-issued photo ID is technically accepted for US citizens on closed-loop cruises, but a passport provides the most flexibility.</p>
        </details>
        <details class="faq-item glass-panel">
          <summary>What should I pack?</summary>
          <p>Pack resort casual wear for days at sea and ports, plus formal or semi-formal attire for the Pirate Night and special dinner evenings. Don't forget sunscreen, swimwear, and comfortable walking shoes for port days.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- ─── CLOSING CTA ─── -->
  <section class="cta-section">
    <div class="cta-inner glass-panel">
      <span class="material-symbols-outlined cta-icon" aria-hidden="true">confirmation_number</span>
      <h2 class="cta-headline">Come Sail With Us!</h2>
      <p class="cta-body">
        We can't wait to celebrate this milestone with you. Reach out to Jackie or Bryan with any questions — and we'll see you aboard the Disney Fantasy!
      </p>
      <a href="https://disneycruise.disney.go.com/" target="_blank" rel="noopener noreferrer" class="btn-primary btn-primary--large">
        Book Your Stateroom
      </a>
    </div>
    <div class="cta-decoration" aria-hidden="true">
      <span class="material-symbols-outlined">explore</span>
    </div>
  </section>
</DefaultLayout>

<script>
  // Live countdown to August 28, 2026
  const target = new Date('2026-08-28T00:00:00').getTime()

  function updateCountdown() {
    const now = Date.now()
    const diff = target - now

    if (diff <= 0) {
      document.getElementById('cd-days')!.textContent = '0'
      document.getElementById('cd-hours')!.textContent = '0'
      document.getElementById('cd-minutes')!.textContent = '0'
      document.getElementById('cd-seconds')!.textContent = '0'
      return
    }

    const days = Math.floor(diff / (1000 * 60 * 60 * 24))
    const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60))
    const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60))
    const seconds = Math.floor((diff % (1000 * 60)) / 1000)

    document.getElementById('cd-days')!.textContent = String(days)
    document.getElementById('cd-hours')!.textContent = String(hours).padStart(2, '0')
    document.getElementById('cd-minutes')!.textContent = String(minutes).padStart(2, '0')
    document.getElementById('cd-seconds')!.textContent = String(seconds).padStart(2, '0')
  }

  updateCountdown()
  setInterval(updateCountdown, 1000)

  // Scrolled class on nav
  const nav = document.getElementById('main-navigation')
  window.addEventListener('scroll', () => {
    nav?.classList.toggle('scrolled', window.scrollY > 40)
  })
</script>

<style lang="scss">
  // ─── shared ───────────────────────────────────────────────
  .section-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .section-headline {
    font-family: 'Noto Serif', Georgia, serif;
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--color-primary);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 0.75rem;
  }

  .section-body {
    color: var(--color-on-surface-variant);
    font-size: 1rem;
    line-height: 1.7;
    margin: 0;
    max-width: 60ch;
  }

  .section-eyebrow {
    display: block;
    font-family: 'Noto Serif', Georgia, serif;
    font-size: 1.125rem;
    color: var(--color-secondary);
    margin-bottom: 0.5rem;
  }

  .section-label-block {
    text-align: center;
    margin-bottom: 4rem;
  }

  // ─── hero ─────────────────────────────────────────────────
  .hero {
    position: relative;
    min-height: 90vh;
    display: flex;
    align-items: center;
    padding: 5rem 2rem 4rem;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: var(--hero-overlay);

    @media (max-width: 1023px) {
      background: var(--hero-overlay-mobile);
    }
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 1280px;
    margin: 0 auto;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;

    @media (min-width: 1024px) {
      grid-template-columns: 7fr 5fr;
    }
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .hero-headline {
    font-family: 'Noto Serif', Georgia, serif;
    font-size: clamp(3rem, 8vw, 5.5rem);
    color: var(--color-on-surface);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin: 0;

    em {
      color: var(--color-primary);
      font-style: italic;
    }
  }

  .hero-body {
    font-size: 1.125rem;
    color: var(--color-on-surface-variant);
    line-height: 1.7;
    max-width: 52ch;
    margin: 0;
    font-weight: 400;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .hero-card-wrap {
    position: relative;

    @media (max-width: 1023px) {
      display: none;
    }
  }

  .hero-ship-card {
    position: relative;
    border-radius: 1.5rem;
    overflow: hidden;
    box-shadow: 0 24px 64px var(--color-shadow-lg);

    &::before {
      content: '';
      position: absolute;
      inset: -0.5rem;
      background: var(--color-tint);
      border-radius: 2rem;
      transform: rotate(2deg);
      z-index: -1;
    }
  }

  .hero-ship-img {
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
    display: block;
  }

  .hero-detail-badge {
    position: absolute;
    bottom: -1.5rem;
    left: -1.5rem;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.875rem 1.5rem;
    border-radius: 9999px;
    box-shadow: 0 10px 32px var(--color-shadow-md);
    border: 1px solid var(--color-border-strong);

    .badge-ship {
      font-family: 'Noto Serif', serif;
      font-style: italic;
      font-size: 1.125rem;
      font-weight: 600;
      color: var(--color-primary);
    }

    .badge-sparkle {
      font-size: 0.625rem;
      color: var(--color-secondary);
      line-height: 1;
    }

    .badge-dates {
      font-family: 'Manrope', system-ui, sans-serif;
      font-size: 1rem;
      font-weight: 600;
      color: var(--color-secondary);
    }
  }

  // ─── buttons ──────────────────────────────────────────────
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 2rem;
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    border-radius: 0.75rem;
    transition: box-shadow 0.2s ease, transform 0.15s ease;
    box-shadow: 0 4px 16px var(--color-shadow-md);

    &:hover {
      box-shadow: 0 8px 32px var(--color-shadow-lg);
      transform: translateY(-1px);
    }

    &--large {
      padding: 1rem 2.5rem;
      font-size: 0.9375rem;
    }
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    padding: 0.875rem 2rem;
    background: transparent;
    color: var(--color-primary);
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    border-radius: 0.75rem;
    border: 1.5px solid var(--color-border-strong);
    transition: background 0.2s ease, border-color 0.2s ease;

    &:hover {
      background: var(--color-tint-subtle);
      border-color: var(--color-primary);
    }
  }

  .btn-booking {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    width: 100%;
    padding: 0.875rem 1.5rem;
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-decoration: none;
    transition: background 0.2s ease;

    .material-symbols-outlined {
      font-size: 1rem;
    }

    &:hover {
      background: var(--color-primary-hover);
    }
  }

  // ─── countdown ────────────────────────────────────────────
  .countdown-section {
    padding: 5rem 0;
    background: var(--color-tint);
    overflow: hidden;
  }

  .countdown-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 3rem;

    @media (min-width: 768px) {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  .countdown-icon {
    font-size: 5rem;
    color: var(--color-primary);
    opacity: 0.15;
    display: none;

    @media (min-width: 768px) {
      display: block;
    }
  }

  .countdown-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;

    @media (min-width: 640px) {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .countdown-cell {
    background: var(--color-surface-card);
    border-radius: 1rem;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    box-shadow: 0 4px 16px var(--color-shadow);
    border: 1px solid var(--color-border);
    transition: background 0.4s ease;

    &:hover {
      background: var(--color-primary);

      .countdown-num,
      .countdown-label {
        color: var(--color-on-primary);
      }
    }
  }

  .countdown-num {
    font-family: 'Noto Serif', Georgia, serif;
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1;
    min-width: 2ch;
    text-align: center;
    transition: color 0.4s ease;
  }

  .countdown-label {
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-on-surface-variant);
