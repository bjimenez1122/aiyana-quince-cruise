---
import { Image } from 'astro:assets'
import DefaultLayout from '../layouts/DefaultLayout.astro'
import KeepExploring from '../components/KeepExploring.astro'
import Section from '../components/Section.astro'
import VoyageTimeline from '../components/VoyageTimeline.astro'
import heroBg from '../assets/photos/disneyfantasycastaway.avif'
import aiyanaPortrait from '../assets/photos/aiyana-daisy.jpg'

const itinerary = [
  { day: 1, date: 'AUG 28', port: 'Port Canaveral' },
  { day: 2, date: 'AUG 29', port: 'Castaway Cay' },
  { day: 3, date: 'AUG 30', port: 'Lookout Cay' },
  { day: 4, date: 'AUG 31', port: 'Nassau' },
  { day: 5, date: 'SEP 1', port: "At Sea · Aiyana's Birthday ✦", birthday: true },
  { day: 6, date: 'SEP 2', port: 'Port Canaveral' },
]
---

<DefaultLayout title="Home">
  <Section width="bleed" rule={false} tight>
    <div class="hero">
      <div class="hero-bg" aria-hidden="true">
        <Image src={heroBg} alt="" class="hero-img" />
        <div class="hero-overlay"></div>
      </div>
      <h1>Aiyana's Quinceañera at Sea</h1>
      <div class="hero-rule" aria-hidden="true"></div>
      <VoyageTimeline variant="hero" ctaHref="/booking" />
    </div>
  </Section>

  <Section class="route-section">
    <header class="route-head">
      <h2 class="route-title">Itinerary Overview</h2>
      <p class="route-lede">A five-night Bahamian voyage on the Disney Fantasy.</p>
    </header>
    <ol class="route-list" aria-label="Voyage timeline">
      {itinerary.map(s => (
        <li class:list={['route-row', { 'is-birthday': s.birthday }]}>
          <a class="route-link" href="/itinerary">
            <span class="route-day">Day {s.day}</span>
            <span class="route-date">{s.date}</span>
            <span class="route-port">{s.port}</span>
          </a>
        </li>
      ))}
    </ol>
    <p class="route-cta-row">
      <a class="route-cta" href="/itinerary">View full itinerary</a>
    </p>
  </Section>

  <Section class="note-section" rule={false}>
    <header class="note-head">
      <span class="eyebrow">A note from us</span>
    </header>
    <div class="note-pair">
      <figure class="note-photo">
        <Image src={aiyanaPortrait} alt="Aiyana" />
      </figure>
      <p class="note-body">
        Aiyana is looking forward to celebrating her birthday with her closest family and friends on her first
        Disney cruise. We hope you can join us as we celebrate and set sail on the Disney Fantasy!
      </p>
    </div>
  </Section>

  <KeepExploring current="home" />
</DefaultLayout>

<style lang="scss">
  // ─── hero ─────────────────────────────────────────────────
  .hero {
    position: relative;
    z-index: 2;
    padding: clamp(40px, 6vw, 80px) 0 clamp(56px, 7vw, 96px);
    text-align: center;

    > *:not(.hero-bg) {
      position: relative;
      z-index: 1;
    }
  }

  .hero-bg {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    height: 100%;
    overflow: hidden;
    z-index: 0;
    pointer-events: none;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 38%;
    display: block;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(250, 243, 226, 0.47) 0%,
      rgba(250, 243, 226, 0.85) 70%
    );
  }

  @media (prefers-color-scheme: dark) {
    .hero-overlay {
      background: linear-gradient(
        180deg,
        rgba(11, 20, 34, 0.47) 0%,
        rgba(11, 20, 34, 0.85) 70%
      );
    }
  }

  // Counter scaled to 80% of base for breathing room above the timeline rail
  :global(.hero .fb-days) {
    font-size: calc(clamp(102px, 18.7vw, 170px) * 0.8);
    color: var(--ink);
    text-shadow: 0 2px 24px rgba(11, 20, 34, 0.5);
    position: relative;
    z-index: 1;
  }
  :global(.hero .fb-days-mark) { font-size: 32px; }
  :global(.hero .fb-cell) {
    background: rgba(11, 20, 34, 0.55);
    box-shadow: inset 0 0 0 1px rgba(234, 217, 160, 0.4);
  }

  // Timeline rail: flex-distributed nodes, track aligned with first/last dot centers
  :global(.hero .vt-nodes) {
    display: flex;
    justify-content: space-between;
    align-items: stretch;
    gap: 0;
  }
  :global(.hero .vt-node) {
    flex: 0 0 22%;
    max-width: 22%;
  }
  // Push badge + days-before-sailing line to the bottom so badges align across all nodes
  :global(.hero .vt-badge) { margin-top: auto; }
  :global(.hero .vt-track) {
    left: 11%;
    right: 11%;
    background: rgba(234, 217, 160, 0.32);
  }
  :global(.hero .vt-date) { text-shadow: 0 1px 12px rgba(11, 20, 34, 0.4); }
  :global(.hero .vt-here-label) {
    background: rgba(11, 20, 34, 0.85);
    color: var(--ink);
  }

  .hero-eyebrow {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 14px;
    font-family: var(--font-family-body);
    font-weight: 600;
    font-size: 16px;
    letter-spacing: 2.6px;
    color: var(--gold);
    text-transform: uppercase;
    padding: 0 20px;
  }

  .hero-eyebrow .sep {
    color: var(--ink-mute);
  }

  @media (max-width: 640px) {
    .hero-eyebrow {
      flex-direction: column;
      align-items: center;
    }
    .hero-eyebrow .sep {
      display: none;
    }
  }

  .hero h1 {
    font-family: var(--font-family-display);
    font-style: normal;
    font-weight: 500;
    font-size: clamp(40px, 5vw, 64px);
    line-height: 1.15;
    letter-spacing: -0.012em;
    margin: 6px 0 0;
    color: var(--ink);
  }

  .hero-rule {
    width: 56px;
    height: 1px;
    background: var(--gold);
    opacity: 0.65;
    margin: 24px auto;
  }

  // ─── route ────────────────────────────────────────────────
  .route-head {
    margin-bottom: var(--space-lg);
    text-align: left;
  }

  .route-title {
    font-family: var(--font-family-display);
    font-style: normal;
    font-weight: 500;
    font-size: clamp(32px, 4vw, 48px);
    line-height: 1.1;
    letter-spacing: -0.012em;
    color: var(--ink);
    margin: 0;
  }

  .route-lede {
    font-family: var(--font-family-body);
    font-size: 17px;
    line-height: 1.55;
    color: var(--ink-soft);
    margin: var(--space-md) 0 0;
    max-width: 56ch;
  }

  .route-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .route-row {
    border-bottom: 1px solid var(--line);
  }

  .route-link {
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: baseline;
    column-gap: var(--space-md);
    padding: var(--space-md) 0;
    text-decoration: none;
    color: inherit;
    transition: color 0.2s ease;

    &:hover .route-port,
    &:focus-visible .route-port {
      color: var(--gold);
    }

    &:focus-visible {
      outline: none;

      .route-day {
        color: var(--gold-deep);
      }
    }
  }

  .route-day {
    font-family: var(--font-family-body);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--ink-mute);
    min-width: 56px;
  }

  .route-date {
    font-family: var(--font-family-label);
    font-size: 12px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--ink-mute);
    min-width: 64px;
  }

  .route-port {
    font-family: var(--font-family-display);
    font-style: normal;
    font-weight: 500;
    font-size: clamp(19px, 1.8vw, 22px);
    line-height: 1.25;
    color: var(--ink);
    transition: color 0.2s ease;
  }

  .route-row.is-birthday .route-port {
    font-weight: 600;
  }

  .route-cta-row {
    margin: var(--space-lg) 0 0;
  }

  .route-cta {
    font-family: var(--font-family-body);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    padding-bottom: 4px;
    transition: color 0.2s ease;

    &:hover,
    &:focus-visible {
      color: var(--gold-deep);
      border-bottom: 1px solid var(--gold);
    }
  }

  @media (max-width: 560px) {
    .route-link {
      grid-template-columns: auto 1fr;
      column-gap: var(--space-sm);
      row-gap: 2px;
      padding: var(--space-md) 0;
    }

    .route-date {
      grid-column: 1;
      min-width: 56px;
    }

    .route-port {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: center;
    }
  }

  // ─── personal note ────────────────────────────────────────
  .note-head {
    margin-bottom: var(--space-md);
    text-align: center;
  }

  .note-head .eyebrow {
    display: block;
  }

  .note-pair {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
  }

  .note-photo {
    margin: 0;
    max-width: 280px;
  }

  .note-photo img {
    width: 100%;
    height: auto;
    display: block;
  }

  .note-body {
    font-family: var(--font-family-display);
    font-style: normal;
    font-weight: 400;
    font-size: clamp(20px, 2.1vw, 26px);
    line-height: 1.45;
    color: var(--ink);
    max-width: 48ch;
    margin: 0;
    text-align: center;
  }

  @media (min-width: 640px) {
    .note-pair {
      flex-direction: row;
      align-items: center;
      gap: var(--space-xl);
    }

    .note-photo {
      flex: 0 0 auto;
      max-width: 240px;
    }

    .note-body {
      text-align: left;
      flex: 1 1 auto;
    }
  }

  // ─── responsive ───────────────────────────────────────────
  @media (max-width: 760px) {
    .hero {
      padding: 28px 0 80px;
    }

    .hero-rule {
      margin: 32px auto;
    }

    .cd-hero #cd-days {
      letter-spacing: -0.03em;
    }
  }
</style>
