---
import { Image } from 'astro:assets'
import DefaultLayout from '../layouts/DefaultLayout.astro'
import KeepExploring from '../components/KeepExploring.astro'
import heroBg from '../assets/photos/disneyfantasycastaway.avif'
import aiyanaPortrait from '../assets/photos/aiyana-daisy.jpg'

const itinerary = [
  { day: 1, date: 'AUG 28', port: 'Port Canaveral' },
  { day: 2, date: 'AUG 29', port: 'Castaway Cay' },
  { day: 3, date: 'AUG 30', port: 'Lookout Cay' },
  { day: 4, date: 'AUG 31', port: 'Nassau' },
  { day: 5, date: 'SEP 1', port: "At Sea · Aiyana's Birthday ✦", birthday: true },
  { day: 6, date: 'SEP 2', port: 'Port Canaveral' },
]
---

<DefaultLayout title="Home · Aiyana's Quinceañera at Sea">
  <section class="hero">
    <div class="hero-bg" aria-hidden="true">
      <Image src={heroBg} alt="" class="hero-img" />
      <div class="hero-overlay"></div>
    </div>

    <div class="hero-eyebrow">
      <span>Aug 28 – Sep 2, 2026</span>
      <span class="sep" aria-hidden="true">·</span>
      <span>Disney Fantasy</span>
      <span class="sep" aria-hidden="true">·</span>
      <span>Port Canaveral → Bahamas</span>
    </div>

    <div class="cd-hero">
      <b id="cd-days" aria-live="polite">—</b>
        <div class="cd-row" aria-hidden="true">
          <span><b id="cd-hours">—</b> hrs</span>
          <span class="cd-sep">·</span>
          <span><b id="cd-minutes">—</b> min</span>
          <span class="cd-sep">·</span>
          <span><b id="cd-seconds">—</b> sec</span>
        </div>
      <span class="cd-label">until we set sail</span>
    </div>

    <div class="hero-rule" aria-hidden="true"></div>

    <h1>Aiyana's Quinceañera <em>at Sea</em></h1>
  </section>

  <section class="route-section">
    <div class="rs-spread">
      <div class="rs-head">
        <h2 class="rs-title">Five stars, <em>one gold line</em></h2>
        <div class="rs-rule" aria-hidden="true"></div>
        <p class="rs-lede">A five-night Bahamian voyage on the Disney Fantasy. Each day mapped, port by port.</p>
        <a class="rs-cta" href="/itinerary">View full itinerary <span aria-hidden="true">→</span></a>
      </div>
      <ol class="rs-grid" aria-label="Voyage timeline">
        {itinerary.map(s => (
          <li class={s.birthday ? 'rs-stop is-birthday' : 'rs-stop'}>
            <a class="rs-link" href="/itinerary">
              <span class="rs-day">Day {s.day}</span>
              <span class="rs-date">{s.date}</span>
              <span class="rs-port">{s.port}</span>
              <span class="rs-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="note">
    <div class="note-grid">
      <figure class="note-photo">
        <Image src={aiyanaPortrait} alt="Aiyana" />
      </figure>
      <div class="note-text">
        <span class="eyebrow">A note from us</span>
        <p>
          Aiyana is looking forward to celebrating her birthday with her closest family and friends on her first
          Disney cruise. We hope you can join us as we celebrate with her on private islands and a beautiful ship.
        </p>
      </div>
    </div>
  </section>

  <KeepExploring current="home" />
</DefaultLayout>

<script>
  const target = new Date('2026-08-28T00:00:00').getTime()

  function updateCountdown() {
    const now = Date.now()
    const diff = target - now
    const days = document.getElementById('cd-days')
    const hours = document.getElementById('cd-hours')
    const minutes = document.getElementById('cd-minutes')
    const seconds = document.getElementById('cd-seconds')
    if (!days || !hours || !minutes || !seconds) return

    if (diff <= 0) {
      days.textContent = '0'
      hours.textContent = '00'
      minutes.textContent = '00'
      seconds.textContent = '00'
      return
    }

    const d = Math.floor(diff / (1000 * 60 * 60 * 24))
    const h = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60))
    const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60))
    const s = Math.floor((diff % (1000 * 60)) / 1000)

    days.textContent = String(d)
    hours.textContent = String(h).padStart(2, '0')
    minutes.textContent = String(m).padStart(2, '0')
    seconds.textContent = String(s).padStart(2, '0')
  }

  updateCountdown()
  setInterval(updateCountdown, 1000)
</script>

<style lang="scss">
  // ─── hero ─────────────────────────────────────────────────
  .hero {
    position: relative;
    z-index: 2;
    padding: 32px 0 48px;
    text-align: center;

    > *:not(.hero-bg) {
      position: relative;
      z-index: 1;
    }
  }

  .hero-bg {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    height: 100%;
    overflow: hidden;
    z-index: 0;
    pointer-events: none;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at center, rgba(11, 20, 34, 0.6) 0%, rgba(11, 20, 34, 0.9) 70%, var(--bg) 100%),
      linear-gradient(180deg, rgba(11, 20, 34, 0.55) 0%, rgba(11, 20, 34, 0.8) 100%);
  }

  @media (prefers-color-scheme: light) {
    .hero-overlay {
      background:
        radial-gradient(ellipse at center, rgba(250, 243, 226, 0.5) 0%, rgba(250, 243, 226, 0.85) 70%, var(--bg) 100%),
        linear-gradient(180deg, rgba(250, 243, 226, 0.5) 0%, rgba(250, 243, 226, 0.75) 100%);
    }
  }

  .hero-eyebrow {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 14px;
    font-family: var(--font-family-body);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 2.6px;
    color: var(--gold);
    text-transform: uppercase;
    padding: 0 20px;
  }

  .hero-eyebrow .sep {
    color: var(--ink-mute);
  }

  .hero h1 {
    font-family: var(--font-family-display);
    font-style: normal;
    font-weight: 400;
    font-size: clamp(39px, 4.8vw, 62px);
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin: 6px 0 0;
    color: var(--ink);

    :global(em) {
      font-style: italic;
      font-weight: 400;
      color: var(--gold);
    }
  }

  .hero-rule {
    width: 56px;
    height: 1px;
    background: var(--gold);
    opacity: 0.65;
    margin: 24px auto;
  }

  .cd-hero {
    padding: 8px 20px 0;
  }

  .cd-hero #cd-days {
    display: block;
    font-family: var(--font-family-display);
    font-style: normal;
    font-weight: 500;
    font-size: clamp(120px, 25vw, 180px);
    line-height: 0.78;
    letter-spacing: -0.06em;
    color: var(--ink);
    font-feature-settings: 'tnum' 1, 'lnum' 1;
  }

  .cd-hero .cd-label {
    display: block;
    font-family: var(--font-family-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(28px, 3vw, 39px);
    letter-spacing: 0.1px;
    color: var(--gold);
    margin-top: 6px;
  }

  .cd-row {
    margin-top: 18px;
    display: inline-flex;
    align-items: baseline;
    gap: 12px;
    font-family: var(--font-family-body);
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 2.4px;
    color: var(--ink-soft);
    text-transform: uppercase;
  }

  .cd-row b {
    font-family: var(--font-family-display);
    font-style: italic;
    font-weight: 500;
    font-size: 22px;
    color: var(--ink);
    margin-right: 5px;
    letter-spacing: 0;
    text-transform: none;
    font-feature-settings: 'tnum' 1, 'lnum' 1;
  }

  .cd-row .cd-sep {
    color: var(--gold);
  }

  // ─── route ────────────────────────────────────────────────
  .route-section {
    padding: 88px 0;
  }

  .rs-spread {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 56px;
    align-items: start;
  }

  .rs-head {
    position: sticky;
    top: 96px;
  }

  .rs-title {
    font-family: var(--font-family-display);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(48px, 5.6vw, 84px);
    line-height: 1;
    letter-spacing: -0.015em;
    color: var(--ink);
    margin: 0;

    :global(em) {
      color: var(--gold);
      font-style: italic;
    }
  }

  .rs-rule {
    width: 56px;
    height: 1px;
    background: var(--gold);
    opacity: 0.7;
    margin: 24px 0 0;
  }

  .rs-lede {
    font-family: var(--font-family-body);
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 22px 0 0;
    max-width: 380px;
  }

  .rs-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 24px;
    font-family: var(--font-family-body);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--gold);
    text-decoration: none;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--gold);
    transition:
      color 0.25s var(--animation-timing, cubic-bezier(0.165, 0.84, 0.44, 1)),
      gap 0.25s var(--animation-timing, cubic-bezier(0.165, 0.84, 0.44, 1));

    &:hover {
      color: var(--gold-deep);
      gap: 12px;
    }
  }

  .rs-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .rs-link {
    text-decoration: none;
    color: inherit;
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--panel);
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    align-items: baseline;
    column-gap: 20px;
    transition:
      border-color 0.3s var(--animation-timing, cubic-bezier(0.165, 0.84, 0.44, 1)),
      background 0.3s var(--animation-timing, cubic-bezier(0.165, 0.84, 0.44, 1));

    &:hover {
      border-color: var(--gold);
      background: linear-gradient(180deg, rgba(234, 217, 160, 0.10), rgba(234, 217, 160, 0.02));
    }

    &:focus-visible {
      outline: none;
      border-color: var(--gold);
      box-shadow: 0 0 0 2px var(--gold);
    }
  }

  .rs-day {
    font-family: var(--font-family-body);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .rs-date {
    font-family: var(--font-family-display);
    font-style: italic;
    font-weight: 500;
    font-size: 14px;
    color: var(--gold);
  }

  .rs-port {
    font-family: var(--font-family-display);
    font-style: italic;
    font-weight: 500;
    font-size: 19px;
    line-height: 1.2;
    color: var(--ink);
  }

  .rs-arrow {
    font-family: var(--font-family-body);
    font-size: 18px;
    color: var(--gold);
    opacity: 0.4;
    transition:
      opacity 0.25s,
      transform 0.3s var(--animation-timing, cubic-bezier(0.165, 0.84, 0.44, 1));
  }

  .rs-link:hover .rs-arrow,
  .rs-link:focus-visible .rs-arrow {
    opacity: 1;
    transform: translateX(4px);
  }

  .rs-stop.is-birthday .rs-link {
    border-color: var(--gold);
    background: linear-gradient(180deg, rgba(234, 217, 160, 0.16), rgba(234, 217, 160, 0.04));
  }

  .rs-stop.is-birthday .rs-day {
    color: var(--gold-deep);
  }

  .rs-stop.is-birthday .rs-port {
    color: var(--gold);
    font-weight: 600;
  }

  .rs-stop.is-birthday .rs-arrow {
    opacity: 0.8;
  }

  @media (max-width: 880px) {
    .rs-spread {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .rs-head {
      position: static;
    }

    .rs-link {
      grid-template-columns: auto 1fr auto;
      column-gap: 14px;
    }

    .rs-date {
      display: none;
    }
  }

  // ─── personal note ────────────────────────────────────────
  .note-grid {
    display: grid;
    grid-template-columns: minmax(240px, 320px) 1fr;
    gap: 64px;
    align-items: center;
    max-width: 980px;
    margin: 0 auto;
  }

  .note-photo {
    margin: 0;
    position: relative;

    img {
      width: 100%;
      height: auto;
      display: block;
      filter: saturate(0.92) contrast(1.02);
    }

    &::after {
      content: '';
      position: absolute;
      left: 14px;
      right: 14px;
      bottom: -10px;
      height: 1px;
      background: var(--gold);
      opacity: 0.55;
    }
  }

  .note-text .eyebrow {
    display: block;
    margin-bottom: 24px;
  }

  .note-text p {
    font-family: var(--font-family-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(20px, 2.1vw, 28px);
    line-height: 1.45;
    color: var(--ink);
    max-width: 38ch;
    margin: 0;
  }

  // ─── responsive ───────────────────────────────────────────
  @media (max-width: 760px) {
    .hero {
      padding: 28px 0 96px;
    }

    .hero-rule {
      margin: 36px auto;
    }

    .cd-hero #cd-days {
      letter-spacing: -0.03em;
    }

    .note-grid {
      grid-template-columns: 1fr;
      gap: 36px;
      max-width: 520px;
    }
  }
</style>
