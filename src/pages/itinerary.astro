---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import DefaultLayout from '../layouts/DefaultLayout.astro'
import PageHero from '../components/PageHero.astro'
import Section from '../components/Section.astro'
import KeepExploring from '../components/KeepExploring.astro'
import castawayCay from '../assets/photos/castaway-cay.jpg'
import cruiseTerminal from '../assets/photos/cruise-terminal.jpg'
import lookoutCay from '../assets/photos/lookout-cay.png'
import nassau from '../assets/photos/nassau-bahamas.jpg'
import fantasyAtrium from '../assets/photos/fantasyAtrium.jpg'

type Day = {
  tag: string
  title: string
  body: string
  img?: ImageMetadata
  alt?: string
  placeholder?: string
  arrive?: string
  depart?: string
  note?: string
}

const days: Day[] = [
  {
    tag: 'DAY 1 · AUG 28',
    title: 'Port Canaveral, FL',
    body: 'Embarkation begins late morning. Sail-away party on the pool deck once we cast off.',
    img: cruiseTerminal,
    alt: 'Disney Cruise Line Terminal',
    depart: '3:00 PM',
  },
  {
    tag: 'DAY 2 · AUG 29',
    title: 'Disney Castaway Cay',
    body: "Disney's private island. Family beach, adults-only beach, kids play area, snorkeling lagoon, and an included BBQ lunch ashore. Snorkel gear, floats, and other rentals are available on-island — or bring your own. Water excursions sell out fast; book early through the Disney Cruise app.",
    img: castawayCay,
    alt: 'Castaway Cay Beach',
    arrive: '8:30 AM',
    depart: '4:45 PM',
    note: 'Semi-formal night onboard (optional).',
  },
  {
    tag: 'DAY 3 · AUG 30',
    title: 'Disney Lookout Cay',
    body: "Disney's second private island on the Bahamas. Pink-sand beaches and a Bahamian cultural center. Same rhythm as Castaway: family + adults-only beaches, included BBQ lunch, optional rentals and excursions.",
    img: lookoutCay,
    alt: 'Lookout Cay Beach',
    arrive: '8:30 AM',
    depart: '4:45 PM',
  },
  {
    tag: 'DAY 4 · AUG 31',
    title: 'Nassau, Bahamas',
    body: 'Explore the capital — straw market, Blue Lagoon, pink houses. Plenty of shore excursions through Disney or on your own.',
    img: nassau,
    alt: 'Nassau Bahamas Atlantis Resort',
    arrive: '8:00 AM',
    depart: '5:30 PM',
    note: 'Pirate Night onboard — deck party and optional dress-up.',
  },
  {
    tag: 'DAY 5 · SEPTEMBER 1',
    title: "Aiyana's Birthday at Sea",
    body: "A full day at sea. We'll have group dinner that evening, and may meet up earlier for pictures. Otherwise, an open day to enjoy the ship.",
    img: fantasyAtrium,
    alt: 'Disney Fantasy Atrium',
    note: "Aiyana's 15th — group dinner.",
  },
  {
    tag: 'DAY 6 · SEP 2',
    title: 'Port Canaveral, FL',
    body: 'Disembarkation begins around 7 AM.',
    img: cruiseTerminal,
    alt: 'Disemarkation & Farewell Brunch',
    arrive: '7:30 AM',
  },
]
---

<DefaultLayout title="Itinerary">
  <PageHero lede="Three ports, including two private islands.">
    The Itinerary
  </PageHero>

  <Section rule={false} tight>
    <div class="itin-prenote">
      <p>
        <strong>Dinner together every night.</strong>
        Disney's rotational dining moves between three themed restaurants, and we have tables booked together for every dinner.
      </p>
    </div>
  </Section>

  <Section width="wide" rule={false}>
    <div class="itin-grid">
      {days.map(day => (
        <div class='day'>
          {day.img ? (
            <div class="day-photo has-img">
              <Image src={day.img} alt={day.alt ?? ''} />
            </div>
          ) : (
            <div class="day-photo">{day.placeholder}</div>
          )}
          <div class="day-body">
            <span class="tag">{day.tag}</span>
            <h3>{day.title}</h3>
            <p>{day.body}</p>
            {day.note && <span class="day-note">{day.note}</span>}
            {(day.arrive || day.depart) && (
              <dl class="times" aria-label="Port times">
                {day.arrive && (
                  <div class="time">
                    <dt>Arrive</dt>
                    <dd>{day.arrive}</dd>
                  </div>
                )}
                {day.depart && (
                  <div class="time">
                    <dt>Depart</dt>
                    <dd>{day.depart}</dd>
                  </div>
                )}
              </dl>
            )}
          </div>
        </div>
      ))}
    </div>
  </Section>

  <KeepExploring current="itinerary" />
</DefaultLayout>

<style lang="scss">
  .map-only {
    padding-top: 40px !important;
  }

  .itin-prenote {
    text-align: center;
  }

  .itin-prenote p {
    font-family: var(--font-family-body);
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink-soft);
    margin: 0;
  }

  .itin-prenote p strong {
    color: var(--ink);
    font-weight: 600;
  }

  .itin-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;

    @media (max-width: 900px) {
      grid-template-columns: repeat(2, 1fr);
    }

    @media (max-width: 560px) {
      grid-template-columns: 1fr;
    }
  }

  .day {
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--panel);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.25s;
  }

  .day:hover {
    border-color: var(--gold);
    transform: translateY(-3px);
  }

  .day-photo {
    aspect-ratio: 16 / 10;
    position: relative;
    background:
      linear-gradient(135deg, rgba(234, 217, 160, 0.12), rgba(122, 160, 200, 0.1)),
      repeating-linear-gradient(135deg, transparent 0 10px, rgba(234, 217, 160, 0.1) 10px 11px);
    display: grid;
    place-items: center;
    overflow: hidden;
    color: var(--ink-mute);
    font-family: var(--font-family-label);
    font-size: 10px;
    letter-spacing: 2px;

    &.has-img {
      background: none;
      padding: 0;
    }

    img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    @media (prefers-color-scheme: light) {
      &:not(.has-img) {
        background:
          linear-gradient(135deg, rgba(168, 127, 42, 0.1), rgba(26, 38, 64, 0.08)),
          repeating-linear-gradient(135deg, transparent 0 10px, rgba(26, 38, 64, 0.09) 10px 11px);
      }
    }
  }

  .day-body {
    padding: 20px 22px 22px;
  }

  .day .tag {
    font-family: var(--font-family-label);
    font-size: 10px;
    letter-spacing: 2.5px;
    color: var(--gold);
  }

  .day h3 {
    font-family: var(--font-family-display);
    font-style: italic;
    font-weight: 600;
    font-size: 24px;
    margin: 4px 0 6px;
    line-height: 1.1;
  }

  .day p {
    color: var(--ink-soft);
    font-size: 13.5px;
    margin: 0;
  }

  .day .day-note {
    display: block;
    margin-top: 10px;
    font-family: var(--font-family-label);
    font-weight: 600;
    font-size: 10px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--gold);
  }

  .day .times {
    margin: 14px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    display: flex;
    gap: 24px;
  }

  .day .time {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .day .time dt {
    font-family: var(--font-family-label);
    font-size: 10px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  .day .time dd {
    font-family: var(--font-family-display);
    font-weight: 500;
    font-size: 16px;
    line-height: 1;
    color: var(--ink);
    margin: 0;
  }
</style>
