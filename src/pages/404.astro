---
import DefaultLayout from '../layouts/DefaultLayout.astro'
---

<DefaultLayout title="404 — Lost at Sea">
  <section class="notfound">
    <div class="notfound-inner">
      <p class="notfound-eyebrow">404</p>
      <h1 class="notfound-headline">Lost at Sea</h1>
      <p class="notfound-body">Looks like this page drifted off course. Let's get you back on board.</p>
      <a class="btn-primary" href="/">Return Home</a>
    </div>
  </section>
</DefaultLayout>

<style lang="scss">
  .notfound {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 2rem;
    text-align: center;
  }

  .notfound-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    max-width: 480px;
  }

  .notfound-eyebrow {
    font-family: 'Noto Serif', Georgia, serif;
    font-style: italic;
    font-size: 1.125rem;
    color: var(--color-secondary);
    margin: 0;
  }

  .notfound-headline {
    font-family: 'Noto Serif', Georgia, serif;
    font-size: clamp(2.5rem, 6vw, 4rem);
    color: var(--color-primary);
    margin: 0;
  }

  .notfound-body {
    color: var(--color-on-surface-variant);
    font-size: 1rem;
    line-height: 1.7;
    margin: 0 0 1rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.875rem 2rem;
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    border-radius: 0.75rem;
    transition: box-shadow 0.2s ease, transform 0.15s ease;
    box-shadow: 0 4px 16px var(--color-shadow-md);

    &:hover {
      box-shadow: 0 8px 32px var(--color-shadow-lg);
      transform: translateY(-1px);
    }
  }
</style>
